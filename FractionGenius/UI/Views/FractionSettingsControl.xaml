<UserControl x:Class="FractionGenius.UI.Views.FractionSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FractionGenius.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.DataContext>
        <vm:FractionSettingsViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <Expander Header="Точная настройка" IsExpanded="{Binding IsChecked, ElementName=OpenSettingsCommand}" >
            <StackPanel>
                <ComboBox x:Name="TemplateSelector" Width="200" Margin="5" 
                          ItemsSource="{Binding SettingsTemplates}" 
                          SelectedItem="{Binding SelectedTemplate}"/>
                <CheckBox Content="Включить скобки" IsChecked="{Binding IncludeBrackets}" Margin="5"/>
                <TextBlock Text="Диапазон значений:" Margin="5"/>
                <DockPanel >
                    <TextBlock Text="Минимум" Margin="5"/>
                    <Slider Minimum="1" Maximum="100" Value="{Binding MinValue}" Margin="9 5 5 5" AutoToolTipPlacement="TopLeft"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Максимум" Margin="5"/>
                    <Slider Minimum="1" Maximum="100" Value="{Binding MaxValue}" Margin="5 5 5 5" AutoToolTipPlacement="TopLeft"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Количество дробей:" Margin="5"/>
                    <Slider Minimum="1" Maximum="10" Value="{Binding FractionCount}" Margin="5" AutoToolTipPlacement="TopLeft"/>
                </DockPanel>
                <TextBlock Text="Операции:" Margin="5"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <CheckBox Content="+" IsChecked="{Binding IncludeAddition}"/>
                    <CheckBox Content="-" IsChecked="{Binding IncludeSubtraction}"/>
                    <CheckBox Content="*" IsChecked="{Binding IncludeMultiplication}"/>
                    <CheckBox Content="/" IsChecked="{Binding IncludeDivision}"/>
                </StackPanel>
                <Button Content="Сохранить как шаблон" Command="{Binding SaveTemplateCommand}" Margin="5"
                        HorizontalAlignment="Center" Style="{StaticResource CombinedButtonStyle}"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
